parameters:
    level: 5
    # jbbcode documents getAttribute() as array, but it returns a string for [tag=value]; the is_array() checks are real.
    treatPhpDocTypesAsCertain: false
    paths:
        - src
    excludePaths:
        - vendor
includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - phpstan-baseline.neon
